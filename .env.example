# Copy this file to `.env` and adjust the values, then run:
#
#     docker compose up -d --build
#
# Generated keys (TAIGA_SECRET_KEY, RABBITMQ_ERLANG_COOKIE) below are
# placeholders. For any real deployment regenerate them, e.g.
#     python -c "import secrets; print(secrets.token_urlsafe(50))"

# ----- Edge -------------------------------------------------------------
# Where users will reach the app from. For a local docker run keep these
# at localhost; for a server set TAIGA_DOMAIN to the public hostname.
HTTP_PORT=9000
TAIGA_SCHEME=http
TAIGA_WS_SCHEME=ws
TAIGA_DOMAIN=localhost:9000
SUBPATH=
COOKIE_SECURE=False

# ----- Database --------------------------------------------------------
POSTGRES_DB=taiga
POSTGRES_USER=taiga
POSTGRES_PASSWORD=change-me-in-production

# ----- Message broker --------------------------------------------------
RABBITMQ_ERLANG_COOKIE=change-me-cookie
RABBITMQ_USER=taiga
RABBITMQ_PASS=change-me-rabbit
RABBITMQ_VHOST=taiga

# ----- Django ----------------------------------------------------------
TAIGA_SECRET_KEY=replace-with-a-long-random-string
# Two flavours of the same flag because Django expects the Python literal
# (True/False) and the front config.json needs JSON-lowercase. Keep them
# in sync.
PUBLIC_REGISTER_ENABLED=True
PUBLIC_REGISTER_ENABLED_JS=true
ATTACHMENTS_MAX_AGE=360

# ----- Email -----------------------------------------------------------
# `console` backend just prints messages to the back container log.
# Switch to `smtp` and fill the rest to actually send email.
DEFAULT_FROM_EMAIL=no-reply@alatoo.edu.kg
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.alatoo.edu.kg
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
